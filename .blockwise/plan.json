{
  "format": "blockwise-plan-v1",
  "title": "Blockwise plan",
  "requirements": [],
  "modules": [
    {
      "path": "sentinel_zero/ledger_writer.py",
      "imports": [
        "import sys",
        "from pathlib import Path"
      ],
      "constants": [
        {
          "name": "MAX_BYTES",
          "value": "1000000"
        }
      ],
      "functions": [
        {
          "name": "resolve_inside",
          "parameters": [
            {
              "name": "root",
              "type": "str"
            },
            {
              "name": "relative",
              "type": "str"
            }
          ],
          "returns": "Path",
          "requirements": [
            "Resolve symlinks and .. first, then require the target to sit strictly inside the resolved root (compare path parts, not string prefixes)."
          ],
          "body": [
            {
              "kind": "branch",
              "condition": "not relative.strip()",
              "body": [
                {
                  "kind": "raise",
                  "expression": "ValueError('refused: the path is empty')"
                }
              ],
              "otherwise": []
            },
            {
              "kind": "assign",
              "target": "base",
              "expression": "Path(root).resolve()",
              "operator": "="
            },
            {
              "kind": "assign",
              "target": "target",
              "expression": "(base / relative).resolve()",
              "operator": "="
            },
            {
              "kind": "branch",
              "condition": "base not in target.parents",
              "body": [
                {
                  "kind": "raise",
                  "expression": "ValueError(f'refused: {relative} is not inside {root}')"
                }
              ],
              "otherwise": []
            },
            {
              "kind": "return",
              "expression": "target"
            }
          ]
        },
        {
          "name": "safe_write_text",
          "parameters": [
            {
              "name": "root",
              "type": "str"
            },
            {
              "name": "relative",
              "type": "str"
            },
            {
              "name": "text",
              "type": "str"
            },
            {
              "name": "max_bytes",
              "type": "int"
            }
          ],
          "returns": "None",
          "requirements": [
            "Every check happens before anything is written."
          ],
          "body": [
            {
              "kind": "assign",
              "target": "data",
              "expression": "text.encode('utf-8')",
              "operator": "="
            },
            {
              "kind": "branch",
              "condition": "len(data) > max_bytes",
              "body": [
                {
                  "kind": "raise",
                  "expression": "ValueError(f'refused: {len(data)} bytes is over the {max_bytes}-byte limit')"
                }
              ],
              "otherwise": []
            },
            {
              "kind": "assign",
              "target": "target",
              "expression": "resolve_inside(root, relative)",
              "operator": "="
            },
            {
              "kind": "call",
              "expression": "target.parent.mkdir(parents=True, exist_ok=True)"
            },
            {
              "kind": "call",
              "expression": "target.write_bytes(data)"
            },
            {
              "kind": "return",
              "expression": "None"
            }
          ]
        },
        {
          "name": "main",
          "parameters": [
            {
              "name": "args",
              "type": "list"
            }
          ],
          "returns": "int",
          "requirements": [
            "Usage: ROOT PATH TEXT. Prints 'saved PATH' or the refusal."
          ],
          "body": [
            {
              "kind": "branch",
              "condition": "len(args) != 3",
              "body": [
                {
                  "kind": "call",
                  "expression": "print('usage: ledger_writer.py ROOT PATH TEXT')"
                },
                {
                  "kind": "return",
                  "expression": "2"
                }
              ],
              "otherwise": []
            },
            {
              "kind": "try",
              "exception": "ValueError",
              "alias": "error",
              "body": [
                {
                  "kind": "call",
                  "expression": "safe_write_text(args[0], args[1], args[2], MAX_BYTES)"
                }
              ],
              "handler": [
                {
                  "kind": "call",
                  "expression": "print(error)"
                },
                {
                  "kind": "return",
                  "expression": "1"
                }
              ],
              "finally": []
            },
            {
              "kind": "call",
              "expression": "print(f'saved {args[1]}')"
            },
            {
              "kind": "return",
              "expression": "0"
            }
          ]
        }
      ],
      "entry": [
        {
          "kind": "call",
          "expression": "sys.exit(main(sys.argv[1:]))"
        }
      ]
    },
    {
      "path": "sentinel_zero/schema_check.py",
      "imports": [],
      "functions": [
        {
          "name": "require_finding_plan_fields",
          "parameters": [
            {
              "name": "plan",
              "type": "dict"
            }
          ],
          "returns": "None",
          "body": [
            {
              "kind": "loop",
              "target": "key",
              "iterable": "('plan_id', 'target_repository', 'asi_classification', 'hypothesis', 'verification_method', 'execution_gate', 'disposition')",
              "body": [
                {
                  "kind": "branch",
                  "condition": "key not in plan",
                  "body": [
                    {
                      "kind": "raise",
                      "expression": "KeyError(key)"
                    }
                  ],
                  "otherwise": []
                }
              ]
            },
            {
              "kind": "return",
              "expression": "None"
            }
          ],
          "requirements": []
        }
      ],
      "constants": []
    },
    {
      "path": "sentinel_zero/catalog_loader.py",
      "imports": [
        "import json"
      ],
      "functions": [
        {
          "name": "load_asi_catalog",
          "parameters": [
            {
              "name": "path",
              "type": "str"
            },
            {
              "name": "fallback",
              "type": "object",
              "default": "None"
            }
          ],
          "returns": "object",
          "body": [
            {
              "kind": "try",
              "exception": "(OSError, ValueError)",
              "body": [
                {
                  "kind": "with",
                  "context": "open(path, encoding='utf-8')",
                  "alias": "handle",
                  "body": [
                    {
                      "kind": "return",
                      "expression": "json.load(handle)"
                    }
                  ]
                }
              ],
              "handler": [
                {
                  "kind": "return",
                  "expression": "fallback"
                }
              ],
              "alias": "",
              "finally": []
            }
          ],
          "requirements": []
        }
      ],
      "constants": []
    }
  ]
}
